rules_version = '2';

// KKTC Taksim Firestore güvenlik kuralları.
// Varsayılan: her şey kapalı. Her aşamada yalnızca gereken yerler açılır (docs/BACKEND_PLANI.md).
// Yüklemek için: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Aşama 1: kullanıcı profili. Herkes yalnızca kendi belgesini okur ve yazar;
    // belgedeki telefon, giriş yapılan telefonla aynı olmak zorunda.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isValidProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(['phone', 'name', 'updatedAt'])
          && data.phone == request.auth.token.phone_number
          && (!('name' in data) || data.name == null
              || (data.name is string && data.name.size() <= 80))
          && data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && isValidProfile();
      // Hesap silme: uygulama kullanıcının verisini kendisi temizler (Profil > Hesabımı sil).
      allow delete: if isOwner();

      // Aşama 2: yolculuk geçmişi. Yalnızca sahibi okur.
      // Not: tamamlanan yolculuğu şimdilik uygulama yazıyor (şoför tarafı yok). Eşleştirme
      // sunucuya taşınınca (Aşama 5) "completed" kayıtları yalnızca sunucu yazabilecek.
      match /trips/{tripId} {
        function isValidTrip(data) {
          return data.keys().hasOnly(['from', 'to', 'dateTime', 'price', 'status', 'taxiType', 'payment'])
            && data.from is string && data.from.size() > 0 && data.from.size() <= 200
            && data.to is string && data.to.size() > 0 && data.to.size() <= 200
            && data.dateTime is int
            && data.price is int && data.price >= 0 && data.price <= 1000000
            && data.status in ['upcoming', 'completed', 'cancelled']
            && (!('taxiType' in data) || data.taxiType == null || data.taxiType in ['economy', 'comfort', 'xl'])
            && (!('payment' in data) || data.payment == null || data.payment in ['cash', 'card']);
        }

        allow read: if isOwner();
        allow create: if isOwner() && isValidTrip(request.resource.data);
        // Tek izin verilen değişiklik: planlanmış yolculuğu iptal etmek (ücret sıfırlanır).
        allow update: if isOwner()
          && resource.data.status == 'upcoming'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'price'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.price == 0;
        // Yalnızca hesap silinirken (sahibi tüm geçmişini siler).
        allow delete: if isOwner();
      }

      // Engellenen kişiler (grup sohbetinde mesajları gizlenir). Yalnızca sahibi görür ve değiştirir.
      match /blocked/{otherId} {
        allow read, delete: if isOwner();
        allow create: if isOwner() && otherId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // Aşama 5: şoförler. Şimdilik herkes kendini şoför olarak kaydedebilir (belge kontrolü yok;
    // docs/UYARILAR.md). Giriş yapan herkes okur: yolcu kendisine atanan şoförü görür.
    match /drivers/{uid} {
      function isPoint(p) {
        return p is map && p.keys().hasAll(['lat', 'lng']) && p.keys().hasOnly(['lat', 'lng'])
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180;
      }

      function isShortText(s, max) {
        return s is string && s.size() > 0 && s.size() <= max;
      }

      function isValidDriver(data) {
        return data.keys().hasAll(['name', 'plate', 'car', 'carColor', 'phone', 'online', 'updatedAt'])
          && data.keys().hasOnly(['name', 'plate', 'car', 'carColor', 'phone', 'online', 'position', 'updatedAt'])
          && isShortText(data.name, 80)
          && isShortText(data.plate, 20)
          && isShortText(data.car, 80)
          && data.carColor in ['white', 'silver', 'black']
          && data.phone == request.auth.token.phone_number
          && data.online is bool
          && (!('position' in data) || data.position == null || isPoint(data.position))
          && data.updatedAt == request.time;
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && isValidDriver(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Aşama 5: çağrılar. Yolcu oluşturur; çevrimiçi şoförler bekleyen çağrıları görür, ilk kabul
    // eden kendini atar (uygulama transaction kullanır). Durum geçişleri burada sınırlanır.
    match /rides/{rideId} {
      function signedIn() {
        return request.auth != null;
      }

      function point(p) {
        return p is map && p.keys().hasAll(['lat', 'lng']) && p.keys().hasOnly(['lat', 'lng'])
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180;
      }

      function place(p) {
        return p is map && p.keys().hasAll(['name', 'lat', 'lng']) && p.keys().hasOnly(['name', 'lat', 'lng'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 200
          && p.lat is number && p.lng is number;
      }

      function driverDoc() {
        return get(/databases/$(database)/documents/drivers/$(request.auth.uid));
      }

      function isOnlineDriver() {
        return signedIn()
          && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
          && driverDoc().data.online == true;
      }

      function isPassenger() {
        return signedIn() && resource.data.passengerId == request.auth.uid;
      }

      function isAssignedDriver() {
        return signedIn() && resource.data.get('driverId', null) == request.auth.uid;
      }

      function changes(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function next() {
        return request.resource.data.status;
      }

      // Kimse almadan iptal edilen çağrıyı da çevrimiçi şoför okur: okuyamazsa Firestore şoförün açık
      // listesindeki eski "searching" kopyasını güncelleyemiyor ve çağrı listede kalıyordu.
      allow read: if isPassenger() || isAssignedDriver()
        || (resource.data.status == 'searching' && isOnlineDriver())
        || (resource.data.status == 'cancelled' && resource.data.get('driverId', null) == null
            && isOnlineDriver());

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['passengerId', 'pickup', 'destination', 'distanceMeters',
            'durationSeconds', 'taxiType', 'payment', 'fareLow', 'fareHigh', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['passengerId', 'pickup', 'destination', 'distanceMeters',
            'durationSeconds', 'taxiType', 'payment', 'fareLow', 'fareHigh', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.passengerId == request.auth.uid
        && place(request.resource.data.pickup)
        && place(request.resource.data.destination)
        && request.resource.data.distanceMeters is number && request.resource.data.distanceMeters >= 0
        && request.resource.data.durationSeconds is number && request.resource.data.durationSeconds >= 0
        && request.resource.data.taxiType in ['economy', 'comfort', 'xl']
        && request.resource.data.payment in ['cash', 'card']
        && request.resource.data.fareLow is int && request.resource.data.fareHigh is int
        && request.resource.data.status == 'searching'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.updatedAt == request.time && (
        // Yolcu: şoför yola çıkmadan / gelmeden iptal; bitince puan.
        (isPassenger()
          && resource.data.status in ['searching', 'driverAssigned', 'driverArrived']
          && next() == 'cancelled' && changes(['status', 'updatedAt']))
        || (isPassenger()
          && resource.data.status == 'completed' && next() == 'completed'
          && changes(['rating', 'updatedAt'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)
        // Çevrimiçi şoför: bekleyen çağrıyı kendine alır.
        || (isOnlineDriver()
          && resource.data.status == 'searching' && next() == 'driverAssigned'
          && changes(['status', 'driverId', 'driver', 'driverPosition', 'updatedAt'])
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.driver is map
          && point(request.resource.data.driverPosition))
        // Atanan şoför: konum yeniler ve sırayla ilerletir ya da iptal eder.
        || (isAssignedDriver()
          && resource.data.status in ['driverAssigned', 'driverArrived', 'inProgress']
          && next() == resource.data.status
          && changes(['driverPosition', 'updatedAt'])
          && point(request.resource.data.driverPosition))
        || (isAssignedDriver()
          && changes(['status', 'driverPosition', 'updatedAt'])
          && ((resource.data.status == 'driverAssigned' && next() == 'driverArrived')
              || (resource.data.status == 'driverArrived' && next() == 'inProgress')
              || (resource.data.status == 'inProgress' && next() == 'completed')
              || (resource.data.status in ['driverAssigned', 'driverArrived'] && next() == 'cancelled')))
      );

      allow delete: if false;
    }

    // Sohbet şikâyetleri. Yalnızca kendi adına oluşturulur; kimse okuyamaz (Firebase konsolundan
    // incelenir). App Store / Google Play kullanıcı içeriği olan uygulamalarda şikâyet ister.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['reporterId', 'reportedId', 'rideId', 'messageId', 'text', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'rideId', 'messageId', 'text', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string
        && request.resource.data.reportedId != request.auth.uid
        && request.resource.data.rideId is string
        && request.resource.data.messageId is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Aşama 3: paylaşımlı gruplar. Giriş yapan herkes görür; üyeliği herkes yalnızca kendisi
    // için değiştirir. Katılma/ayrılmayı uygulama transaction ile yapar; kurallar ise tek bir
    // üyenin eklenip çıkarılmasından başka değişikliği reddeder.
    match /sharedRides/{rideId} {
      function signedIn() {
        return request.auth != null;
      }

      function isValidSharedRide(data) {
        return data.keys().hasAll(['from', 'to', 'departure', 'capacity', 'memberIds', 'pricePerPerson'])
          && data.keys().hasOnly(['from', 'to', 'departure', 'capacity', 'memberIds', 'pricePerPerson'])
          && data.from is string && data.from.size() > 0 && data.from.size() <= 200
          && data.to is string && data.to.size() > 0 && data.to.size() <= 200
          && data.departure is int && data.departure > request.time.toMillis()
          && data.capacity is int && data.capacity >= 1 && data.capacity <= 8
          && data.pricePerPerson is int && data.pricePerPerson > 0 && data.pricePerPerson <= 100000;
      }

      function onlyMembersChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }

      function isJoin() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return !(request.auth.uid in before)
          && after == before.concat([request.auth.uid])
          && after.size() <= resource.data.capacity
          && resource.data.departure > request.time.toMillis();
      }

      // Son üye listeyi boşaltmaz, grubu siler (aşağıdaki delete).
      function isLeave() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        return request.auth.uid in before
          && after == before.removeAll([request.auth.uid])
          && after.size() > 0;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && isValidSharedRide(request.resource.data)
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if signedIn() && onlyMembersChange() && (isJoin() || isLeave());
      allow delete: if signedIn() && resource.data.memberIds == [request.auth.uid];

      // Grup sohbeti. Yalnızca o anki üyeler okur ve yazar; mesajlar değiştirilemez.
      // Gönderenin telefonu değil, yalnızca adı tutulur.
      match /messages/{messageId} {
        function groupPath() {
          return /databases/$(database)/documents/sharedRides/$(rideId);
        }

        function isMember() {
          return signedIn() && exists(groupPath())
            && request.auth.uid in get(groupPath()).data.memberIds;
        }

        function isValidMessage(data) {
          return data.keys().hasAll(['senderId', 'senderName', 'text', 'sentAt'])
            && data.keys().hasOnly(['senderId', 'senderName', 'text', 'sentAt'])
            && data.senderId == request.auth.uid
            && (data.senderName == null || (data.senderName is string && data.senderName.size() <= 80))
            && data.text is string && data.text.size() > 0 && data.text.size() <= 500
            && data.sentAt == request.time;
        }

        allow read: if isMember();
        allow create: if isMember() && isValidMessage(request.resource.data);
        allow update: if false;
        // Son üye ayrılırken grubu silmeden önce mesajları temizler; hesabını silen üye de kendi
        // mesajlarını siler.
        allow delete: if signedIn() && exists(groupPath())
          && (get(groupPath()).data.memberIds == [request.auth.uid]
              || (resource.data.senderId == request.auth.uid
                  && request.auth.uid in get(groupPath()).data.memberIds));
      }
    }

    // Aşama 4: canlı konum paylaşımı. Yolcu yolculuk sırasında bir takip bağlantısı paylaşır;
    // bağlantıyı açan (uygulaması ve hesabı olmayan) kişi belgeyi kimliğiyle okur. Kimlik tahmin
    // edilemez (Firestore'un 20 karakterlik rastgele kimliği) ve listeleme kapalı. Paylaşım
    // yolculuk bitince "ended" olur ve konum silinir; en geç `expiresAt`'te okunamaz hale gelir.
    match /liveShares/{shareId} {
      function isPoint(p) {
        return p is map && p.keys().hasAll(['lat', 'lng']) && p.keys().hasOnly(['lat', 'lng'])
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180;
      }

      function isShortText(s) {
        return s is string && s.size() > 0 && s.size() <= 200;
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerId;
      }

      allow get: if resource.data.expiresAt > request.time.toMillis() || isOwner();
      // Başkalarının paylaşımları listelenemez; sahibi kendi paylaşımlarını (hesap silerken) listeler.
      allow list: if isOwner();

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['ownerId', 'from', 'to', 'destination', 'driverName',
            'plate', 'car', 'status', 'position', 'updatedAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'from', 'to', 'destination', 'driverName',
            'plate', 'car', 'status', 'position', 'updatedAt', 'expiresAt'])
        && request.resource.data.ownerId == request.auth.uid
        && isShortText(request.resource.data.from)
        && isShortText(request.resource.data.to)
        && isPoint(request.resource.data.destination)
        && isShortText(request.resource.data.driverName)
        && isShortText(request.resource.data.plate)
        && isShortText(request.resource.data.car)
        && request.resource.data.status == 'active'
        && isPoint(request.resource.data.position)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 6 * 60 * 60 * 1000;

      // Sahibi yalnızca konumu yeniler ya da paylaşımı bitirir (konum silinir); bitmiş paylaşım
      // yeniden açılamaz.
      allow update: if isOwner()
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position', 'updatedAt', 'status'])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'active' && isPoint(request.resource.data.position))
            || (request.resource.data.status == 'ended' && !('position' in request.resource.data)));

      allow delete: if isOwner();
    }
  }
}
